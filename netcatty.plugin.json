{
  "manifestVersion": 1,
  "id": "com.binaricat.netcatty-database",
  "name": "netcatty-database",
  "displayName": {
    "en": "Netcatty Database",
    "zh-CN": "Netcatty 数据库"
  },
  "description": {
    "en": "Experimental SQLite workbench with host-owned saved connections and mock-only SQL drafts.",
    "zh-CN": "实验性 SQLite 工作台，支持宿主管理的已保存连接和仅供模拟的 SQL 草稿。"
  },
  "version": "0.1.0-alpha.1",
  "publisher": "binaricat",
  "license": "GPL-3.0-or-later",
  "engines": {
    "netcatty": ">=0.0.0",
    "api": ">=0.1.0-internal.1 <0.2.0"
  },
  "features": {
    "required": [
      "views.host-drawn",
      "views.vault-pages"
    ],
    "optional": [
      "database.sqlite-fixture.v1",
      "database.sqlite-file-fixture.v1",
      "database.saved-connections.v1"
    ]
  },
  "main": {
    "browser": "browser.js"
  },
  "activationEvents": [
    "onView:com.binaricat.netcatty-database.workbench"
  ],
  "permissions": {
    "required": [
      "views"
    ],
    "optional": [
      {
        "permission": "database.query.read",
        "resources": [
          "sqlite:synthetic-notes",
          "sqlite:disposable-file"
        ],
        "reason": "Read synthetic memory or a host-selected disposable SQLite file / 读取模拟内存数据库或宿主选择的一次性 SQLite 文件"
      },
      {
        "permission": "database.query.write",
        "resources": [
          "sqlite:synthetic-notes"
        ],
        "reason": "Review each write to disposable synthetic SQLite / 逐次审查对一次性模拟 SQLite 数据库的写入"
      },
      "storage",
      "vault.metadata",
      "secrets"
    ]
  },
  "contributes": {
    "views": [
      {
        "id": "com.binaricat.netcatty-database.workbench",
        "title": {
          "en": "Database",
          "zh-CN": "数据库"
        },
        "location": "vault-page"
      }
    ]
  }
}
