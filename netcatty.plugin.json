{
  "manifestVersion": 1,
  "id": "com.binaricat.netcatty-database",
  "name": "netcatty-database",
  "displayName": {
    "en": "Netcatty Database",
    "zh-CN": "Netcatty 数据库"
  },
  "description": {
    "en": "Plugin-owned SQLite memory workbench for Netcatty main. Additional drivers are not yet ported.",
    "zh-CN": "适用于 Netcatty main 的插件自有 SQLite 内存工作台，其他驱动尚未迁移。"
  },
  "version": "0.1.0-alpha.9",
  "publisher": "binaricat",
  "license": "GPL-3.0-or-later",
  "engines": {
    "netcatty": ">=0.0.0",
    "api": ">=0.1.0-internal.1 <0.2.0"
  },
  "features": {
    "required": [
      "views.host-drawn",
      "views.vault-pages",
      "metadata.brand-icon",
      "ai.model-invocation",
      "ai.agent-sessions",
      "vault.host-actions",
      "host.interactions"
    ]
  },
  "main": {
    "browser": "browser.js"
  },
  "activationEvents": [
    "onView:com.binaricat.netcatty-database.workbench",
    "onView:com.binaricat.netcatty-database.connection"
  ],
  "permissions": {
    "required": [
      "views"
    ],
    "optional": [
      "storage",
      {
        "permission": "ai.invoke",
        "resources": [
          "*"
        ],
        "reason": "Request unexecuted SQL drafts using schema metadata / 使用数据库结构请求未执行的 SQL 草稿"
      },
      {
        "permission": "ai.agent.use",
        "resources": [
          "*"
        ],
        "reason": "Optional host Agent conversations; no tool actions / 可选宿主 Agent 对话，不启用工具操作"
      },
      {
        "permission": "vault.metadata",
        "resources": [
          "*"
        ],
        "reason": "Choose existing hosts using host UI / 通过宿主界面选择已有主机"
      },
      {
        "permission": "ui.interact",
        "resources": [
          "*"
        ],
        "reason": "Request selected host SSH connection in native host UI / 在宿主界面请求已选主机 SSH 连接"
      },
      {
        "permission": "clipboard.write",
        "resources": [
          "*"
        ],
        "reason": "Copy explicitly reviewed returned query results using host clipboard controls / 通过宿主剪贴板接口复制已返回的查询结果"
      }
    ]
  },
  "contributes": {
    "views": [
      {
        "id": "com.binaricat.netcatty-database.workbench",
        "title": {
          "en": "Database",
          "zh-CN": "数据库"
        },
        "location": "vault-page"
      },
      {
        "id": "com.binaricat.netcatty-database.connection",
        "title": {
          "en": "Database: New connection",
          "zh-CN": "数据库：新建连接"
        },
        "location": "modal"
      }
    ]
  },
  "icon": {
    "kind": "package",
    "light": "assets/icons/sqlite-light.png",
    "dark": "assets/icons/sqlite-dark.png"
  }
}
