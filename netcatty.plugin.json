{
  "manifestVersion": 1,
  "id": "com.binaricat.netcatty-database",
  "name": "netcatty-database",
  "displayName": {
    "en": "Netcatty Database",
    "zh-CN": "Netcatty 数据库"
  },
  "description": {
    "en": "Plugin-owned SQLite memory workbench for Netcatty main. Additional drivers are not yet ported.",
    "zh-CN": "适用于 Netcatty main 的插件自有 SQLite 内存工作台，其他驱动尚未迁移。"
  },
  "version": "0.1.0-alpha.1",
  "publisher": "binaricat",
  "license": "GPL-3.0-or-later",
  "engines": {
    "netcatty": ">=0.0.0",
    "api": ">=0.1.0-internal.1 <0.2.0"
  },
  "features": {
    "required": [
      "views.host-drawn",
      "views.vault-pages",
      "metadata.brand-icon",
      "ai.model-invocation"
    ]
  },
  "main": {
    "browser": "browser.js"
  },
  "activationEvents": [
    "onView:com.binaricat.netcatty-database.workbench"
  ],
  "permissions": {
    "required": [
      "views"
    ],
    "optional": [
      "storage",
      {
        "permission": "ai.invoke",
        "resources": [
          "*"
        ],
        "reason": "Request unexecuted SQL drafts using schema metadata / 使用数据库结构请求未执行的 SQL 草稿"
      }
    ]
  },
  "contributes": {
    "views": [
      {
        "id": "com.binaricat.netcatty-database.workbench",
        "title": {
          "en": "Database",
          "zh-CN": "数据库"
        },
        "location": "vault-page"
      }
    ]
  },
  "icon": {
    "kind": "package",
    "light": "assets/icons/sqlite-light.png",
    "dark": "assets/icons/sqlite-dark.png"
  }
}
